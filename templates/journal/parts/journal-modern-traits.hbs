<table class="core-traits">
    <caption>{{ localize "JOURNALENTRYPAGE.BLEACHD20.Class.Traits.Caption" class=linked.name }}</caption>
    <tbody>
        <tr>
            <th scope="row">{{ localize "BLEACHD20.CLASS.FIELDS.primaryAbility.value.label" }}</th>
            <td>{{ primaryAbility }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "BLEACHD20.CLASS.FIELDS.hd.label" }}</th>
            <td>{{ localize "JOURNALENTRYPAGE.BLEACHD20.Class.HitPoints.HitDiceModern" dice=advancement.hp.hitDice
                   class=linked.name }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "BLEACHD20.TraitSavesPlural.other" }}</th>
            <td>{{ advancement.traits.saves }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "BLEACHD20.TraitSkillsPlural.other" }}</th>
            <td>{{ advancement.traits.skills }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "BLEACHD20.TraitWeaponPlural.other" }}</th>
            <td>{{ advancement.traits.weapons }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "BLEACHD20.TraitToolPlural.other" }}</th>
            <td>{{ advancement.traits.tools }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "BLEACHD20.TraitArmorPlural.other" }}</th>
            <td>{{ advancement.traits.armor }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "BLEACHD20.StartingEquipment.Title" }}</th>
            <td>{{{ advancement.equipment }}}</td>
        </tr>
    </tbody>
</table>
